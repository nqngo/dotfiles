{{ if and (eq .chezmoi.os "linux") (.chezmoi.kernel.osrelease | lower | contains "microsoft") -}}
#!/usr/bin/env bash
set -euo pipefail

WSL_CONF="/etc/wsl.conf"
DESIRED_OPTIONS='"metadata,umask=22,fmask=11"'

# Ensure [automount] options includes metadata while preserving existing sections
UPDATED=$(python3 - "$WSL_CONF" "$DESIRED_OPTIONS" <<'PY'
import configparser
import os
import sys

path, desired = sys.argv[1], sys.argv[2]
cfg = configparser.ConfigParser()
if os.path.exists(path):
    cfg.read(path)

current = cfg.get("automount", "options", fallback="").strip()
if current.strip('"') == desired.strip('"'):
    print("unchanged")
    sys.exit(0)

if not cfg.has_section("automount"):
    cfg.add_section("automount")
cfg.set("automount", "options", desired)

out_path = "/tmp/wsl.conf.chezmoi"
with open(out_path, "w") as f:
    cfg.write(f)
print("updated")
PY
)

if [ "$UPDATED" = "updated" ]; then
    sudo install -m 0644 /tmp/wsl.conf.chezmoi "$WSL_CONF"
    rm -f /tmp/wsl.conf.chezmoi
    echo "Updated $WSL_CONF with [automount] options = $DESIRED_OPTIONS."
    echo "Run 'wsl --shutdown' from PowerShell, then reopen WSL for mount options to take effect."
    echo "After reopening WSL, run: chmod 600 \"\$(readlink -f ~/.ssh/config)\""
else
    echo "$WSL_CONF already configured with automount metadata."
fi

# If ~/.ssh/config exists and metadata is active, ensure 0600 permissions
if [ -e "$HOME/.ssh/config" ]; then
    chmod 600 "$(readlink -f "$HOME/.ssh/config")" 2>/dev/null || true
fi
{{ end -}}
